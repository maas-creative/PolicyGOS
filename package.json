{
  "name": "policygos",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-bound policy document OCR, structured extraction, human review, and OpenUI generation.",
  "license": "MIT",
  "homepage": "https://maas-creative.github.io/PolicyGOS/",
  "repository": {
    "type": "git",
    "url": "https://github.com/maas-creative/PolicyGOS.git"
  },
  "bugs": {
    "url": "https://github.com/maas-creative/PolicyGOS/issues"
  },
  "engines": {
    "node": ">=22.22"
  },
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "type-check": "pnpm -r --if-present type-check",
    "test": "pnpm -r --if-present test && node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:real": "node scripts/real-provider-e2e.mjs",
    "evaluate:gold": "node scripts/evaluate-gold.mjs",
    "lint": "eslint .",
    "check": "pnpm build && pnpm lint && pnpm type-check && pnpm test && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
