# Server-side only. Never expose these values through VITE_* variables.
POLICYGOS_DEPLOYMENT=local
REPORTMETA_PROVIDER=local
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: use a faster non-reasoning-capable model for OpenUI composition.
OPENUI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OCR_BACKEND_URL=http://127.0.0.1:8000
OCR_API_TOKEN=
POLICYGOS_HOST=127.0.0.1
POLICYGOS_PORT=8787
# Required only for POLICYGOS_DEPLOYMENT=public.
POLICYGOS_ACCESS_TOKENS=
POLICYGOS_RATE_LIMIT_PER_MINUTE=30
POLICYGOS_MAX_CONCURRENT_OCR=2
POLICYGOS_AUDIT_LOG_PATH=
# true blocks any provider URL whose host is not localhost.
POLICYGOS_LOCAL_ONLY=true
